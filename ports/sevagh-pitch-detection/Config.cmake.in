@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_path(PITCH_DETECTION_INCLUDE_DIR NAMES pitch_detection.h
    PATHS "${PACKAGE_PREFIX_DIR}/include"
    NO_DEFAULT_PATH)
find_library(PITCH_DETECTION_LIBRARY_RELEASE NAMES pitch_detection PATHS "${PACKAGE_PREFIX_DIR}/lib" NO_DEFAULT_PATH)
find_library(PITCH_DETECTION_LIBRARY_DEBUG NAMES pitch_detection PATHS "${PACKAGE_PREFIX_DIR}/debug/lib" NO_DEFAULT_PATH)

if(NOT TARGET pitch_detection)
    add_library(pitch_detection UNKNOWN IMPORTED)
    set_target_properties(pitch_detection PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${PITCH_DETECTION_INCLUDE_DIR}"
    )

    if(PITCH_DETECTION_LIBRARY_RELEASE)
        set_property(TARGET pitch_detection APPEND PROPERTY IMPORTED_CONFIGURATIONS RELEASE)
        set_target_properties(pitch_detection PROPERTIES IMPORTED_LOCATION_RELEASE "${PITCH_DETECTION_LIBRARY_RELEASE}")
    endif()

    if(PITCH_DETECTION_LIBRARY_DEBUG)
        set_property(TARGET pitch_detection APPEND PROPERTY IMPORTED_CONFIGURATIONS DEBUG)
        set_target_properties(pitch_detection PROPERTIES IMPORTED_LOCATION_DEBUG "${PITCH_DETECTION_LIBRARY_DEBUG}")
    endif()
endif()
